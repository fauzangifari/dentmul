// DentMul — Prisma Schema v1.0
// Sistem Skrining Awal Teledentistry RSGM Universitas Mulawarman

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  PASIEN
  KOAS
  DOSEN
  ADMIN
}

enum JenisKelamin {
  LAKI_LAKI
  PEREMPUAN
}

enum StatusSkrining {
  MENUNGGU      // baru dikirim pasien, belum ditinjau koas
  DITINJAU      // sudah dibuka koas
  MENUNGGU_ACC  // koas sudah kirim edukasi, menunggu ACC dosen
  SELESAI       // sudah di-ACC dosen, edukasi terlihat pasien
}

enum PengisiSkrining {
  PASIEN_SENDIRI
  ORANG_TUA_WALI
}

// Urutan deklarasi = urutan sort (SEGERA paling atas di daftar kasus)
enum PrioritasSkrining {
  SEGERA         // ada tanda bahaya / nyeri berat — perlu ditangani segera
  EVALUASI_LESI  // sariawan/benjolan ≥ 2 minggu — perlu evaluasi lesi
  RUTIN
}

// ============================================================
// MODELS
// ============================================================

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  password      String?       // Opsional karena user Google tidak punya password
  emailVerified DateTime?     // Auth.js requirement
  image         String?       // Auth.js requirement (foto profil Google)
  role          Role          @default(PASIEN)
  isActive      Boolean       @default(true)  // soft-delete: user nonaktif tidak bisa login

  // Data Demografis Pasien (nullable — tidak wajib untuk role KOAS)
  nik          String?       @unique  // Nomor Induk Kependudukan 16 digit
  jenisKelamin JenisKelamin?
  alamat       String?
  tanggalLahir DateTime?             // umur dihitung dinamis dari field ini
  noTelepon    String?              // Nomor telepon/HP pasien untuk kontak

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relasi
  skrinings    Skrining[]    // pasien → banyak skrining
  kasusKoas    KasusPasien[] // koas → banyak kasus yang ditangani
  edukasiKoas  Edukasi[]     @relation("EdukasiKoas")  // koas → banyak edukasi yang dikirim
  edukasiDiacc Edukasi[]     @relation("EdukasiDosen") // dosen → banyak edukasi yang di-ACC

  // Auth.js Relations
  sessions    Session[]
}

model Skrining {
  id     String @id @default(cuid())
  userId String

  // Versi formulir: 1 = isian bebas (lama), 2 = anamnesis terstruktur.
  // Kolom keluhan lama tetap diisi pada versi 2 (dibangkitkan otomatis oleh
  // server) agar daftar kasus, pencarian, dan data lama tetap berfungsi.
  versiForm Int             @default(1)
  pengisi   PengisiSkrining @default(PASIEN_SENDIRI)
  prioritas PrioritasSkrining @default(RUTIN) // dihitung server saat submit

  // Data Keluhan (Anamnesa)
  keluhanUtama    String  // v2: label pendek, contoh "Gigi sakit · 46"
  keluhanTambahan String? // v2: label keluhan ke-2 dst.
  durasiKeluhan   String  // contoh: "3 hari", "1 minggu"
  lokasiSakit     String? // contoh: "Rahang kanan atas"
  skalaNyeri      Int?    // Skala nyeri 0–10 (v1: 1–10)

  // Detail Keluhan (v2) — berlaku untuk keluhan utama.
  // Nilai opsi berupa kode String; daftar & label ada di
  // features/skrining/constants.ts (bisa ditambah tanpa migrasi).
  durasiAngka      Int?
  durasiSatuan     String?  // HARI | MINGGU | BULAN | TAHUN
  onset            String?  // TIBA_TIBA | PERLAHAN | TIDAK_INGAT
  perkembangan     String?  // MAKIN_PARAH | TETAP | MEMBAIK | HILANG_TIMBUL
  riwayatPerawatan String[] @default([])
  jenisNyeri       String?  // NGILU | BERDENYUT | TAJAM | TUMPUL
  polaNyeri        String?  // SPONTAN | DIPICU
  pemicuNyeri      String[] @default([])
  lamaNyeriPemicu  String?  // DETIK | MENIT
  waktuNyeri       String[] @default([])
  nyeriBangunTidur Boolean?
  dampak           String[] @default([])
  upaya            String[] @default([])
  keteranganObat   String?  // nama obat & hasilnya, bila upaya MINUM_OBAT
  gejalaLain       String[] @default([])
  tandaBahaya      String[] @default([]) // kode tanda bahaya yang dijawab "Ya"; kosong = semua "Tidak"

  // Riwayat Medis (Medical History)
  riwayatPenyakit String? // Jantung, Diabetes, Asma, dll — boleh kosong
  alergiObat      String? // boleh kosong
  obatRutin       String? // Obat yang sedang dikonsumsi saat ini
  kebiasaanBuruk  String? // Merokok, alkohol, bruxism (menggeretakkan gigi), dll

  // Status & Timestamps
  status    StatusSkrining @default(MENUNGGU)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // Relasi
  user    User              @relation(fields: [userId], references: [id])
  foto    FotoSkrining[]
  keluhan KeluhanSkrining[] // v2: satu baris per keluhan (urutan 0 = keluhan utama)
  kasus   KasusPasien?      // one-to-one, dibuat oleh koas
  edukasi Edukasi?          // one-to-one, dikirim oleh koas
}

// Jenis & lokasi tiap keluhan pada formulir v2. Pasien bisa menambah lebih
// dari satu keluhan; urutan 0 adalah keluhan utama.
model KeluhanSkrining {
  id           String   @id @default(cuid())
  skriningId   String
  urutan       Int
  jenis        String[] // GIGI_SAKIT, GUSI_BENGKAK, SARIAWAN, ... (boleh lebih dari satu)
  jenisLainnya String?  // isian bebas bila jenis LAINNYA
  area         String   // GIGI | GUSI | LIDAH | PIPI_DALAM | LANGIT_LANGIT | DASAR_MULUT | BIBIR | SENDI_RAHANG | WAJAH_LEHER

  // Area GIGI / GUSI — odontogram
  jenisGigi   String?           // DEWASA | SUSU
  gigi        Int[]   @default([]) // notasi FDI: 11–48 (dewasa), 51–85 (susu)
  tidakYakin  Boolean @default(false) // pasien tidak yakin giginya → isi regio
  regioRahang String?           // ATAS | BAWAH
  regioSisi   String?           // KANAN | KIRI (dari sisi pasien)
  regioSegmen String?           // DEPAN | BELAKANG

  // Area jaringan lunak & wajah
  titikJaringanLunak String? // BIBIR_ATAS | LANGIT_LANGIT | PIPI_KANAN | LIDAH | PIPI_KIRI | DASAR_MULUT | BIBIR_BAWAH
  sisiWajah          String? // KANAN | KIRI | KEDUA (sendi rahang / wajah-leher)

  sebaran   String   // SATU_TITIK | MENYEBAR | MENJALAR
  cerita    String   // cerita keluhan dengan kata-kata pasien sendiri
  createdAt DateTime @default(now())

  // Relasi — cascade delete: jika skrining dihapus, keluhan ikut terhapus
  skrining Skrining @relation(fields: [skriningId], references: [id], onDelete: Cascade)

  @@unique([skriningId, urutan])
}

model FotoSkrining {
  id         String   @id @default(cuid())
  skriningId String
  url        String   // URL publik dari Uploadthing / Supabase Storage
  key        String   // Storage key — dipakai untuk delete foto
  createdAt  DateTime @default(now())

  // Relasi — cascade delete: jika skrining dihapus, foto ikut terhapus
  skrining Skrining @relation(fields: [skriningId], references: [id], onDelete: Cascade)
}

model KasusPasien {
  id         String  @id @default(cuid())
  skriningId String  @unique
  koasId     String

  // Menggunakan String (bukan Enum) agar kategori bisa ditambah secara fleksibel
  // tanpa perlu migrasi database. Preset pilihan dikelola di sisi frontend.
  // Contoh nilai: "Karies", "Periodontal", "Oral Hygiene", "Sakit Gigi", dll.
  kategori    String  @default("Lainnya")
  isPotensial Boolean @default(false)
  catatan     String? // Catatan internal koas — tidak terlihat oleh pasien

  updatedAt DateTime @updatedAt

  // Relasi
  skrining Skrining @relation(fields: [skriningId], references: [id])
  koas     User     @relation(fields: [koasId], references: [id])
}

model Edukasi {
  id         String   @id @default(cuid())
  skriningId String   @unique
  koasId     String
  konten     String   // Teks edukasi / rekomendasi yang dikirim ke pasien
  createdAt  DateTime @default(now())

  // Persetujuan (ACC) oleh dosen — edukasi baru terlihat pasien setelah di-ACC
  dosenId      String?   // dosen yang meng-ACC / menolak
  catatanDosen String?   // alasan penolakan (opsional) — juga penanda pernah ditolak
  reviewedAt   DateTime? // waktu dosen memproses (ACC / tolak)

  // Relasi
  skrining Skrining @relation(fields: [skriningId], references: [id])
  koas     User     @relation("EdukasiKoas", fields: [koasId], references: [id])
  dosen    User?    @relation("EdukasiDosen", fields: [dosenId], references: [id])
}

// ============================================================
// NEXTAUTH (AUTH.JS) MODELS
// ============================================================
 
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@map("sessions")
}
